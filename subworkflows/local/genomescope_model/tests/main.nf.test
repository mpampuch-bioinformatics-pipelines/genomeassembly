// TODO nf-core: Once you have added the required tests, please run the following command to build this file:
// nf-core subworkflows test genomescope_model
nextflow_workflow {

    name "Test Subworkflow GENOMESCOPE_MODEL"
    script "../main.nf"
    workflow "GENOMESCOPE_MODEL"

    tag "subworkflows"
    tag "subworkflows_local"
    tag "subworkflows/genomescope_model"
    // TODO nf-core: Add tags for all modules used within this subworkflow

    // TODO nf-core: Change the test name preferably indicating the test-data and file-format used
    test("galderia_gt20kb_50x - non-trio - no mat reads - no pat reads") {

        when {
            workflow {
                """
                // TODO nf-core: define inputs of the workflow here. Example:
                input[0] = [
                    [ id:'Galderia_gt20kb_50x', single_end:false ], // meta map
                    file('/ibex/project/c2303/20251019_Galdi-T2T-Assembly/OUTPUTS/20251023_155416/Galderia_sulphuria_GT20KBreads_50x.fastq.gz', checkIfExists: true)
                ]
                input[1] = [
                    [ id:'Galderia_gt20kb_50x' ],
                    []
                ]
                input[2] = [
                    [ id:'Galderia_gt20kb_50x' ],
                    []
                ]
                input[3] = Channel.value('non_trio')
                """

                
            }
        }

        then {            
            assertAll(
                { assert workflow.success },
                { assert snapshot(
                    workflow.out.hist,
                    workflow.out.ktab,
                    workflow.out.model,
                    workflow.out.smu,
                    workflow.out.txt,
                    workflow.out.versions,
                ).match() 
                },
                {
                    with(workflow.out.pdf) {
                        assert size() == 1  // Check we have one sample
                        with(get(0)) {
                            assert get(0).id == 'Galderia_gt20kb_50x'  // Check meta
                            with(get(1)) {  // Check files
                                assert get(0) ==~ /.*Galderia_gt20kb_50x_centralities\.pdf.*/
                                assert get(1) ==~ /.*Galderia_gt20kb_50x_smudgeplot\.pdf.*/
                                assert get(2) ==~ /.*Galderia_gt20kb_50x_smudgeplot_log10\.pdf.*/
                            }
                        }
                    }
                },
                { assert workflow.out.matdb.flatten().isEmpty() },
                { assert workflow.out.mhapktab.flatten().isEmpty() },
                { assert workflow.out.patdb.flatten().isEmpty() },
                { assert workflow.out.phapktab.flatten().isEmpty() },
                { assert workflow.out.tsv.flatten().isEmpty() }

                //TODO nf-core: Add all required assertions to verify the test output.
            )
        }
    }
}
