// TODO nf-core: Once you have added the required tests, please run the following command to build this file:
// nf-core modules test smudgeplot/all
nextflow_process {

    name "Test Process SMUDGEPLOT_ALL"
    script "../main.nf"
    process "SMUDGEPLOT_ALL"

    tag "modules"
    tag "modules_"
    tag "smudgeplot"
    tag "smudgeplot/all"

    // TODO nf-core: Change the test name preferably indicating the test-data and file-format used
    test("single smu file") {

        // TODO nf-core: If you are created a test for a chained module
        // (the module requires running more than one process to generate the required output)
        // add the 'setup' method here.
        // You can find more information about how to use a 'setup' method in the docs (https://nf-co.re/docs/contributing/modules#steps-for-creating-nf-test-for-chained-modules).

        when {
            process {
                """
                // TODO nf-core: define inputs of the process here. Example:
                
                input[0] = [
                    [ id: 'Galderia_gt20kb_50x' ], // meta map
                    file('/ibex/project/c2303/20251019_Galdi-T2T-Assembly/TESTS/TEST_DATA/KMERS/Galderia_gt20kb_50x_text.smu')
                ]
                """
            }
        }

        then {
            // println "Process output: ${process.out}"
            // println "Process output.size(): ${process.out.size()}"
            // println "Process output[0]: ${process.out[0]}"
            // println "Process output[0].size(): ${process.out[0].size()}"
            // println "Process output[0][0]: ${process.out[0][0]}"
            // println "Process output[0][0].size(): ${process.out[0][0].size()}"
            // println "Process output[0][0][0]: ${process.out[0][0][0]}"
            // println "Process output[0][0][0].size(): ${process.out[0][0][0].size()}"
            // println "Process output[0][0][1]: ${process.out[0][0][1]}"
            // println "Process output[0][0][1].size(): ${process.out[0][0][1].size()}"
            // println "Process output.pdf: ${process.out.pdf}"
            // println "Process output.pdf.size(): ${process.out.pdf.size()}"
            // println "Process output.pdf[0]: ${process.out.pdf[0]}"
            // println "Process output.pdf[0].size(): ${process.out.pdf[0].size()}"
            // println "Process output.pdf[0][0]: ${process.out.pdf[0][0]}"
            // println "Process output.pdf[0][0].size(): ${process.out.pdf[0][0].size()}"
            // println "Process output.pdf[0][1]: ${process.out.pdf[0][1]}"
            // println "Process output.pdf[0][1].size(): ${process.out.pdf[0][1].size()}"
            // println "Process output.tsv: ${process.out.tsv}"
            // println "Process output.tsv.size(): ${process.out.tsv.size()}"
            // println "Process output.txt: ${process.out.txt}"
            // println "Process output.txt.size(): ${process.out.txt.size()}"
            
            

            
            assertAll(
                { assert process.success },
                { assert process.out.tsv.isEmpty() },  // More descriptive than size() == 0
                { assert snapshot(process.out.txt).match() },
                { 
                    with(process.out.pdf) {
                        assert size() == 1  // Check we have one sample
                        with(get(0)) {
                            assert get(0).id == 'Galderia_gt20kb_50x'  // Check meta
                            with(get(1)) {  // Check files
                                assert get(0) ==~ /.*Galderia_gt20kb_50x_centralities\.pdf.*/
                                assert get(1) ==~ /.*Galderia_gt20kb_50x_smudgeplot\.pdf.*/
                                assert get(2) ==~ /.*Galderia_gt20kb_50x_smudgeplot_log10\.pdf.*/
                            }
                        }
                    }
                }
            )
        }

    }

}
